# Fast wild encounter hunt for Pokémon Ultra Sun.
# Runs in a tight circle with the circle pad until a wild battle starts,
# checks the opponent, and runs from non-shinies.

#logfile "logs/wild_encounter_fast.txt"
set encounters 0

log "[WILD] Fast hunt started"

repeat forever

    inc encounters
    log "[WILD] ===== Encounter attempt #{encounters} ====="

    log "[WILD] Running in a circle"
    repeat 80
        hold CPAD_RIGHT
        release CPAD_RIGHT
        hold CPAD_DOWN
        release CPAD_DOWN
        hold CPAD_LEFT
        release CPAD_LEFT
        hold CPAD_UP
        release CPAD_UP
    end
    release_all

    log "[WILD] Waiting for battle intro to finish"
    delay 7s

    log "[WILD] Checking opponent for encounter #{encounters}"
    if shiny opponent
        log "[WILD] SHINY FOUND on encounter #{encounters}"
        break
    else
        log "[WILD] Encounter #{encounters} is not shiny"
    end

    log "[WILD] Running from battle"
    press DOWN
    delay 500ms
    press DOWN
    delay 500ms
    press DOWN
    delay 500ms
    press A
    delay 6s

    log "[WILD] Ready for next encounter"

end

release_all
log "[WILD]"
log "[WILD]           *"
log "[WILD]          ***"
log "[WILD]     *************"
log "[WILD]   ***  SHINY  ***"
log "[WILD]     *************"
log "[WILD]          ***"
